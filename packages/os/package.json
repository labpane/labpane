{
  "name": "@labpane/os",
  "version": "1.4.1",
  "description": "Tabs and resizable split panes for React",
  "license": "MIT",
  "homepage": "https://labpane.com",
  "bugs": "https://github.com/labpane/labpane/issues",
  "keywords": [
    "react",
    "tabs",
    "split-panes",
    "workspace",
    "docking",
    "layout"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/os/index.d.ts",
      "default": "./dist/index.js"
    },
    "./pwa": {
      "types": "./dist/os/pwa.d.ts",
      "default": "./dist/pwa.js"
    },
    "./styles.css": {
      "types": "./dist/styles.d.ts",
      "default": "./dist/styles.css"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/labpane/labpane.git",
    "directory": "packages/os"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json && esbuild index.ts pwa.ts --bundle --sourcemap --format=esm --packages=external --outdir=dist && esbuild styles.css --minify --outfile=dist/styles.css && node ../package-assets.mjs",
    "test": "bun test",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss3": "npm:tailwindcss@^3.4.17",
    "typescript": "^7.0.2"
  }
}
